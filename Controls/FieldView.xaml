<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dalla.Controls.FieldView">
    <VerticalStackLayout Spacing="4">
        <Label x:Name="TitleLabel" Style="{StaticResource Secondary}" />
        <Border x:Name="Frame" Style="{StaticResource FieldBorder}" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                <Entry x:Name="Input"
                       TextChanged="OnTextChanged"
                       Focused="OnFocused"
                       Unfocused="OnUnfocused" />
                <Button x:Name="ToggleButton"
                        Grid.Column="1"
                        IsVisible="False"
                        Text="Afficher"
                        FontSize="14"
                        Padding="8,0"
                        MinimumWidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Clicked="OnToggleClicked" />
            </Grid>
        </Border>
        <Label x:Name="ErrorLabel"
               IsVisible="False"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Expense}, Dark={StaticResource ExpenseDark}}" />
    </VerticalStackLayout>
</ContentView>
