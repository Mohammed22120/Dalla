<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dalla.Controls"
             x:Class="Dalla.Views.HouseholdHubPage"
             Title="Foyer">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,112" Spacing="16">

            <Label Text="Foyer" Style="{StaticResource H1}" />

            <!-- Carte du foyer -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="HouseName" Style="{StaticResource H2}" />
                    <Label x:Name="HouseInfo" Style="{StaticResource Secondary}" />
                    <HorizontalStackLayout x:Name="AvatarRow" Spacing="-8" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Entrées de menu -->
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,0" MinimumHeightRequest="64">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnMembersTapped" /></Grid.GestureRecognizers>
                        <controls:LucideIcon Name="users" Size="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Membres" VerticalOptions="Center" />
                        <controls:LucideIcon Grid.Column="2" Name="chevron-right" Size="20" Muted="True" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Separator}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,0" MinimumHeightRequest="64">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetTapped" /></Grid.GestureRecognizers>
                        <controls:LucideIcon Name="wallet" Size="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Budget mensuel" VerticalOptions="Center" />
                        <controls:LucideIcon Grid.Column="2" Name="chevron-right" Size="20" Muted="True" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Separator}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,0" MinimumHeightRequest="64">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriesTapped" /></Grid.GestureRecognizers>
                        <controls:LucideIcon Name="tag" Size="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Catégories" VerticalOptions="Center" />
                        <controls:LucideIcon Grid.Column="2" Name="chevron-right" Size="20" Muted="True" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Separator}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,0" MinimumHeightRequest="64">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsTapped" /></Grid.GestureRecognizers>
                        <controls:LucideIcon Name="settings" Size="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Profil et paramètres" VerticalOptions="Center" />
                        <controls:LucideIcon Grid.Column="2" Name="chevron-right" Size="20" Muted="True" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
        <controls:BottomNavBar Active="foyer" />
    </Grid>
</ContentPage>
