<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dalla.Controls"
             xmlns:models="clr-namespace:Dalla.Models"
             x:Class="Dalla.Views.MembersPage"
             Title="Membres du foyer"
             Shell.TabBarIsVisible="False">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <controls:LucideButton Icon="arrow-left" Clicked="OnBackClicked"
                            SemanticProperties.Description="Retour" />
                    <Label Grid.Column="1" Text="Membres du foyer" Style="{StaticResource H1}" VerticalOptions="Center" />
                </Grid>

                <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="16,8">
                    <VerticalStackLayout x:Name="MemberList">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MemberRow">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,10" MinimumHeightRequest="64">
                                        <controls:AvatarView Initial="{Binding Initial}" AvatarColor="{Binding Color}" Size="44" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding Role}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{Binding TotalText}" Style="{StaticResource ExpenseAmount}" FontSize="14" HorizontalTextAlignment="Start" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Separator}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- État vide : seul membre du foyer -->
                <Border x:Name="SoloCard" Style="{StaticResource Card}" IsVisible="False">
                    <controls:EmptyState Icon="users"
                                         Message="Tu es le seul membre du foyer. Invite ta famille pour partager le budget !"
                                         ButtonText="Inviter un membre"
                                         ActionClicked="OnInviteClicked" />
                </Border>

                <Button x:Name="InviteButton" Text="Inviter un membre" Style="{StaticResource PrimaryButton}"
                        Clicked="OnInviteClicked" />

                <!-- Code et lien de partage -->
                <Border x:Name="InvitePanel" Style="{StaticResource Card}" IsVisible="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Code d'invitation" Style="{StaticResource H2}" />
                        <Label x:Name="CodeLabel" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label x:Name="LinkLabel" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Copier le code" Style="{StaticResource SecondaryButton}" Clicked="OnCopyClicked" />
                            <Button Grid.Column="1" Text="Partager" Style="{StaticResource PrimaryButton}" Clicked="OnShareClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="Snack" Style="{StaticResource Snack}">
            <Label Style="{StaticResource SnackLabel}" />
        </Border>
    </Grid>
</ContentPage>
