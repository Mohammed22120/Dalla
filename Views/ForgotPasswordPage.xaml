<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dalla.Controls"
             x:Class="Dalla.Views.ForgotPasswordPage"
             Title="Mot de passe oublié"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <controls:LucideButton Icon="arrow-left" Clicked="OnBackClicked"
                        SemanticProperties.Description="Retour" />
                <Label Grid.Column="1" Text="Mot de passe oublié" Style="{StaticResource H1}" VerticalOptions="Center" />
            </Grid>

            <Label Text="Pas de souci. Saisis ton e-mail et on t'envoie un lien pour choisir un nouveau mot de passe."
                   Style="{StaticResource Secondary}" FontSize="16" />

            <controls:FieldView x:Name="Email" Title="E-mail" Placeholder="prenom@exemple.cm" KeyboardType="Email" />

            <!-- Message de confirmation -->
            <Border x:Name="SuccessBox" IsVisible="False" Style="{StaticResource Card}"
                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                    StrokeThickness="2" Padding="12">
                <Label x:Name="SuccessLabel" FontSize="14" />
            </Border>

            <Button x:Name="SendButton" Text="Envoyer le lien" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Clicked="OnSendClicked" />
            <ActivityIndicator x:Name="Loader" IsRunning="False" IsVisible="False" HeightRequest="28" />

            <Label Text="Retour à la connexion" Style="{StaticResource LinkLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Démo : essaie ismaila@exemple.cm (connu) ou une autre adresse (inconnue)"
                   Style="{StaticResource Secondary}" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
