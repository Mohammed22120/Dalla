<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dalla.Controls"
             xmlns:models="clr-namespace:Dalla.Models"
             x:Class="Dalla.Views.StatsPage"
             Title="Statistiques">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,112" Spacing="16">

            <Label Text="Statistiques" Style="{StaticResource H1}" />

            <!-- Sélecteur de mois -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:LucideButton x:Name="PrevButton" Icon="chevron-left" Clicked="OnPrevClicked"
                        SemanticProperties.Description="Mois précédent" />
                <Label x:Name="MonthLabel" Grid.Column="1" Style="{StaticResource H2}"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <controls:LucideButton x:Name="NextButton" Grid.Column="2" Icon="chevron-right" HorizontalOptions="End" Clicked="OnNextClicked"
                        SemanticProperties.Description="Mois suivant" />
            </Grid>

            <!-- État vide -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" IsVisible="False">
                <controls:EmptyState x:Name="Empty" Icon="chart-column"
                                     Message="Pas encore de données pour ce mois. Ajoute une dépense pour voir tes statistiques."
                                     ButtonText="Ajouter une dépense" />
            </Border>

            <VerticalStackLayout x:Name="StatsContent" Spacing="16">

                <!-- Répartition par catégorie (anneau + légende textuelle) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Répartition par catégorie" Style="{StaticResource H2}" />
                        <GraphicsView x:Name="DonutView" HeightRequest="220"
                                      SemanticProperties.Description="Diagramme en anneau de la répartition des dépenses par catégorie" />
                        <VerticalStackLayout x:Name="LegendList" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LegendRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,60" ColumnSpacing="8" MinimumHeightRequest="32">
                                        <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6"
                                                 Color="{Binding Dot}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding AmountText}" FontSize="14" VerticalOptions="Center"
                                               HorizontalTextAlignment="End" />
                                        <Label Grid.Column="3" Text="{Binding PercentText}" FontSize="14" FontAttributes="Bold"
                                               VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Par membre -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Dépenses par membre" Style="{StaticResource H2}" />
                        <GraphicsView x:Name="BarsView" HeightRequest="200"
                                      SemanticProperties.Description="Histogramme des dépenses par membre" />
                    </VerticalStackLayout>
                </Border>

                <!-- Évolution sur 6 mois -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Évolution sur 6 mois" Style="{StaticResource H2}" />
                        <GraphicsView x:Name="LineView" HeightRequest="200"
                                      SemanticProperties.Description="Courbe de l'évolution des dépenses sur 6 mois" />
                        <Label x:Name="LineSummary" Style="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
        <controls:BottomNavBar Active="stats" />
    </Grid>
</ContentPage>
