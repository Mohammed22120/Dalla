<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Couleurs principales (cahier des charges §4.2) -->
    <Color x:Key="Primary">#1E5AA8</Color>
    <Color x:Key="PrimaryDark">#3A74C4</Color>
    <Color x:Key="PrimaryLight">#E8F0FA</Color>
    <Color x:Key="Success">#2E9E6B</Color>
    <Color x:Key="Expense">#E4572E</Color>
    <Color x:Key="Warning">#F5A623</Color>
    <Color x:Key="SecondaryColor">#2CB1BC</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- Neutres mode clair -->
    <Color x:Key="BgLight">#F7F9FC</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="TextLight">#1F2937</Color>
    <Color x:Key="Text2Light">#6B7280</Color>
    <Color x:Key="BorderLight">#E5E7EB</Color>
    <Color x:Key="DisabledBgLight">#E5E7EB</Color>
    <Color x:Key="DisabledTextLight">#9CA3AF</Color>

    <!-- Mode sombre -->
    <Color x:Key="BgDark">#0F172A</Color>
    <Color x:Key="CardDark">#1E293B</Color>
    <Color x:Key="TextDark">#F1F5F9</Color>
    <Color x:Key="Text2Dark">#94A3B8</Color>
    <Color x:Key="BorderDark">#334155</Color>
    <Color x:Key="DisabledBgDark">#334155</Color>
    <Color x:Key="DisabledTextDark">#64748B</Color>
    <Color x:Key="ExpenseDark">#F0775A</Color>
    <Color x:Key="SuccessDark">#3DB982</Color>

    <!-- Catégories -->
    <Color x:Key="CatAlimentation">#4C9A82</Color>
    <Color x:Key="CatLogement">#1E5AA8</Color>
    <Color x:Key="CatTransport">#F5A623</Color>
    <Color x:Key="CatSante">#D9689B</Color>
    <Color x:Key="CatLoisirs">#7C5CBF</Color>
    <Color x:Key="CatEducation">#2CB1BC</Color>
    <Color x:Key="CatFactures">#6B7280</Color>
    <Color x:Key="CatAutres">#A3A3A3</Color>

</ResourceDictionary>
